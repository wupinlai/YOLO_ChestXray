# Python
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/
.env
.venv
env/
venv/

# Datasets (large image files and annotations)
datasets/chestxray8/train/images/*
datasets/chestxray8/train/labels/*
